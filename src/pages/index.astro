---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import portrait from "../assets/portrait-hero.jpg";
import apps from "../data/apps.json";
import {
  availabilityLine,
  caseStudies,
  companies,
  config,
  contact,
  education,
  experience,
  hackathon,
  hero,
  identity,
  inDevelopment,
  ownApps,
  pillars,
  skills,
  about,
  tmdbAttribution,
  tracks,
  headings,
  journey,
} from "../data/profile";

type Store = { name: string; rating: number | null; ratingCount: number; screenshots: number };
const store = apps as Record<string, Store>;
const rating = store.toastNow?.rating ?? 4.9;
const ratingCount = store.toastNow ? `~${Math.round(store.toastNow.ratingCount / 1000)}K` : "~12K";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/appstore/*.jpg", { eager: true });
const image = (file: string) => images[`../assets/appstore/${file}`]?.default;
const shots = (key: string) =>
  Array.from({ length: store[key]?.screenshots ?? 0 }, (_, i) => image(`${key}-shot-${i + 1}.jpg`)).filter((s): s is ImageMetadata => Boolean(s));

const caseMeta = {
  toastNow: [
    { k: "Company", v: "Toast, Inc." },
    { k: "Platform", v: "iOS, now Android too" },
    { k: "Team", v: "Retail Inventory" },
  ],
  xtrachef: [
    { k: "Company", v: "Toast, Inc." },
    { k: "Platform", v: "iOS" },
    { k: "Mode", v: "Offline-first" },
  ],
} as const;
const year = new Date().getFullYear();
---

<Base title={`${identity.name}, Senior iOS Developer`}>
  <div class="curtain" aria-hidden="true"><span><b>Imran</b><i></i></span></div>
  <a class="skip" href="#main">Skip to content</a>

  <header class="top" id="top-bar">
    <div class="wrap">
      <a class="logo" href="#top">Imran<sup>®</sup></a>
      <nav aria-label="Sections">
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#work">Work</a></li>
          <li><a href="#awards">Hackathons</a></li>
          <li><a href="#apps">Apps</a></li>
          <li><a href="#experience">Experience</a></li>
        </ul>
      </nav>
      <div class="end">
        <button class="theme" type="button" data-theme-toggle aria-label="Switch theme">
          <Icon name="moon" size={17} />
          <Icon name="sun" size={17} />
        </button>
        <a class="pill light" href="#contact" aria-label="Get in touch"><span>Get in touch</span><span class="arrow"><Icon name="arrow" size={16} stroke={2.2} /></span></a>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-photo">
        <Picture
          src={portrait}
          alt={identity.name}
          formats={["avif", "webp"]}
          fallbackFormat="jpg"
          widths={[360, 480, 640, 800, 941]}
          sizes="(max-width: 900px) 100vw, 62vw"
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="wrap">
        <div class="hero-inner">
          <div>
            <p class="greeting fade" style="--d:.15s">{hero.greeting}</p>
            <h1 id="hero-title">
              <span class="sr-only">{identity.name}, </span>
              {
                hero.title.map((t, i) => (
                  <>
                    <span class="t">
                      <span style={`--i:${i}`}>{t}</span>
                    </span>{" "}
                  </>
                ))
              }
            </h1>
          </div>
          <div class="hero-side fade" style="--d:.7s">
            <blockquote>{hero.quote}</blockquote>
            <p>{hero.sub}</p>
            <div class="row">
              <a class="pill" href={`mailto:${identity.email}`}><span>Email me</span><span class="arrow"><Icon name="arrow" size={16} stroke={2.2} /></span></a>
              <button class="tlink" type="button" data-copy={identity.email} aria-label="Copy email address">Copy email</button>
              <span class="copied" role="status"></span>
            </div>
          </div>
        </div>
        <ul class="services" aria-label="What I do">
          {
            hero.services.map((s, i) => (
              <li style={`--i:${i}`}>
                <b>
                  <span>#</span>
                  {s.n}
                </b>
                <p>{s.t}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <div class="strip">
      <div class="wrap">
        <p class="lbl">Where I've built mobile apps since 2014</p>
        <div class="marquee">
          <ul class="track" aria-label="Companies">
            {companies.map((c) => <li>{c}</li>)}
            {companies.map((c) => <li aria-hidden="true">{c}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <section class="section" id="about" aria-labelledby="about-title">
      <div class="wrap">
        <div class="head">
          <h2 id="about-title" data-reveal>
            <span class="label">{headings.about.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.about.plain} <em class="accent">{headings.about.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>{about}</p>
          </div>
        </div>

        <ul class="bento">
          <li class="tile journey" data-reveal>
            <p class="kicker">The journey</p>
            <p class="fig"><span data-count="12">12</span>+<span class="unit">years</span></p>
            <ol class="path">
              {
                journey.map((j) => (
                  <li>
                    <time datetime={j.year}>{j.year}</time>
                    <span><b>{j.place}</b>{j.what}</span>
                  </li>
                ))
              }
            </ol>
          </li>
          <li class="tile crimson" data-reveal style="--d:.08s">
            <p class="kicker">Reliability</p>
            <p class="fig"><span data-count="99">99</span>%</p>
            <p class="cap-sm">98–99% crash-free on Toast Now, backed by unit tests, Crashlytics and CI/CD.</p>
          </li>
          <li class="tile deep" data-reveal style="--d:.16s">
            <p class="kicker">Toast Now</p>
            <p class="fig">
              <span data-count={rating} data-dec="1">{rating.toFixed(1)}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.6l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17.1l-5.9 3.3 1.3-6.5L2.5 9.4l6.6-.8z" /></svg>
              <span class="sr-only">out of 5</span>
            </p>
            <p class="cap-sm">App Store rating from {ratingCount} ratings. The app I build inventory features for.</p>
          </li>
          {
            tracks.map((t, i) => (
              <li class="tile track" data-reveal style={`--d:${0.08 + i * 0.08}s`}>
                <p class="since">{t.since}</p>
                <h3>{t.platform}</h3>
                <p>{t.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <div class="wrap">
        <div class="head">
          <h2 id="work-title" data-reveal>
            <span class="label">{headings.work.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.work.plain} <em class="accent">{headings.work.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>At Toast I build the inventory and invoicing features that restaurant operators and managers use every day. Both apps keep working offline and sync when the network returns.</p>
          </div>
        </div>
        <div class="cases">
          {
            caseStudies.map((c, i) => (
              <article class:list={["case", { alt: i % 2 === 1 }]} data-reveal aria-labelledby={`case-${c.key}`}>
                <div>
                  <p class="year">{c.company}</p>
                  <h3 id={`case-${c.key}`}>{c.name}</h3>
                  <p class="intro">{c.intro}</p>
                </div>
                <ul class="points">
                  {c.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <div class="meta">
                  <dl style="display:contents">
                    {caseMeta[c.key].map((m) => (
                      <div>
                        <dt>
                          <span>#</span>
                          {m.k}
                        </dt>
                        <dd>{m.v}</dd>
                      </div>
                    ))}
                  </dl>
                  <a class="pill light" href={c.url} rel="noopener">
                    <span>App Store</span>
                    <span class="arrow">
                      <Icon name="out" size={15} stroke={2.2} />
                    </span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" id="awards" aria-labelledby="awards-title">
      <div class="wrap">
        <div class="head">
          <h2 id="awards-title" data-reveal>
            <span class="label">{headings.awards.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.awards.plain} <em class="accent">{headings.awards.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>Two hackathon entries, both about making inventory counts faster for restaurant staff.</p>
          </div>
        </div>

        <ul class="awards">
          <li class="award-row" data-reveal>
            <span class="yr">2026</span>
            <div>
              <h3>{hackathon.name}</h3>
              <p>{hackathon.tagline} {hackathon.meta}.</p>
            </div>
            <p class="res">{hackathon.result}</p>
          </li>
          <li class="award-row" data-reveal style="--d:.08s">
            <span class="yr">2024</span>
            <div>
              <h3>{hackathon.voice.name}</h3>
              <p>{hackathon.voice.text}</p>
            </div>
            <p class="res">Runner-up</p>
          </li>
        </ul>

        <div class="process">
          <div data-reveal>
            <h3>{hackathon.name}, step by step</h3>
            <p class="pdesc">{hackathon.problem}</p>
            <p class="ptext">{hackathon.built}</p>
          </div>
          <ol class="steps" id="steps" data-reveal style="--d:.1s">
            {
              hackathon.steps.map((s, i) => (
                <li class:list={["step", { on: i === 0 }]} tabindex="0">
                  <span class="n">0{i + 1}</span>
                  <h4>{s.title}</h4>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <ul class="guard">
          {
            hackathon.guardrails.map((g, i) => (
              <li data-reveal style={`--d:${i * 0.06}s`}>
                <Icon name={g.icon} />
                <h4>{g.title}</h4>
                <p>{g.text}</p>
              </li>
            ))
          }
        </ul>
        <p class="honest">{hackathon.honest}</p>
      </div>
    </section>

    <section class="section" id="apps" aria-labelledby="apps-title">
      <div class="wrap">
        <div class="head">
          <h2 id="apps-title" data-reveal>
            <span class="label">{headings.apps.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.apps.plain} <em class="accent">{headings.apps.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>Three apps of my own on the App Store, designed, built and released end to end.</p>
          </div>
        </div>
        <div class="apps">
          {
            ownApps.map((app, i) => {
              const icon = image(`${app.key}-icon.jpg`);
              const s = app.featured ? shots(app.key) : [];
              return (
                <article class:list={["app", app.key]} data-reveal style={`--d:${i * 0.1}s`} aria-labelledby={`app-${app.key}`}>
                  <div class="visual" aria-hidden="true">
                    {s.length > 0 ? (
                      <ul class="shots">
                        {s.map((src) => (
                          <li>
                            <Picture src={src} alt="" formats={["avif", "webp"]} widths={[130, 260]} sizes="130px" quality={65} />
                          </li>
                        ))}
                      </ul>
                    ) : (
                      icon && <Image src={icon} alt="" width={180} height={180} widths={[180, 360]} sizes="180px" class="big-icon" />
                    )}
                  </div>
                  <div class="row">
                    {icon && <Image src={icon} alt="" width={40} height={40} widths={[40, 80]} sizes="40px" />}
                    <div>
                      <h3 id={`app-${app.key}`}>{app.name}</h3>
                      <p class="meta">{app.meta}</p>
                    </div>
                  </div>
                  <p>{app.text}</p>
                  {app.downloads && (
                    <div class="dl">
                      <p class="dl-total">
                        <span data-count={app.downloads.total} data-sep="true">{app.downloads.total.toLocaleString("en-US")}</span>
                        <small>downloads, {app.downloads.source}, as of {app.downloads.asOf}</small>
                      </p>
                      <ul class="dl-split" aria-label="Downloads by device">
                        {app.downloads.byDevice.map((d) => (
                          <li style={`--share:${((d.count / app.downloads!.total) * 100).toFixed(2)}%`}>
                            <span>{d.device}</span>
                            <b>{d.count.toLocaleString("en-US")}</b>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  <p class="links">
                    <a class="tlink" href={app.url} rel="noopener">
                      App Store <Icon name="out" size={14} stroke={2.2} />
                    </a>
                    {app.links && (
                      <a class="tlink sub" href={app.links.privacy} aria-label={`${app.name} privacy policy`}>
                        Privacy
                      </a>
                    )}
                    {app.links && (
                      <a class="tlink sub" href={app.links.support} aria-label={`${app.name} support`}>
                        Support
                      </a>
                    )}
                  </p>
                </article>
              );
            })
          }
        </div>
        <p class="attribution">{tmdbAttribution}</p>
        {
          config.showInDevelopment && (
            <ul class="attribution">
              {inDevelopment.map((d) => (
                <li>In development: {d}</li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section class="section" id="how" aria-labelledby="how-title">
      <div class="wrap">
        <div class="head">
          <h2 id="how-title" data-reveal>
            <span class="label">{headings.how.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.how.plain} <em class="accent">{headings.how.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>The habits I bring to every codebase, at work and in my own apps.</p>
          </div>
        </div>
        <ul class="pillars">
          {
            pillars.map((p, i) => (
              <li class="pillar" data-reveal style={`--d:${i * 0.08}s`}>
                <span class="ic">
                  <Icon name={p.icon === "check" ? "circlecheck" : p.icon} size={26} />
                </span>
                <span class="bar" aria-hidden="true" />
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="exp-title">
      <div class="wrap">
        <div class="head">
          <h2 id="exp-title" data-reveal>
            <span class="label">{headings.experience.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.experience.plain} <em class="accent">{headings.experience.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>From iOS developer in Chennai to team lead in Phnom Penh, and now senior engineer at Toast.</p>
          </div>
        </div>
        <ol class="roles">
          {
            experience.map((r, i) => (
              <li class:list={["role", { current: i === 0 }]} data-reveal style={`--d:${Math.min(i, 3) * 0.05}s`}>
                <p class="years">
                  <time datetime={r.from}>{r.from}</time>
                  <small> – {r.to === "Present" ? "Present" : <time datetime={r.to}>{r.to}</time>}</small>
                </p>
                <div>
                  <h3>
                    {r.role}
                    <span>{r.company}</span>
                  </h3>
                  <p class="text">{r.text}</p>
                </div>
                <p class="place">{r.place}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" id="skills" aria-labelledby="skills-title">
      <div class="wrap">
        <div class="head">
          <h2 id="skills-title" data-reveal>
            <span class="label">{headings.skills.label}</span><span class="sr-only">: </span>
            <span class="big">{headings.skills.plain} <em class="accent">{headings.skills.accent}</em></span>
          </h2>
          <div class="side" data-reveal style="--d:.1s">
            <p>Native iOS first, Android in Kotlin, and the data, delivery and AI tooling around them.</p>
          </div>
        </div>
        <ul class="skills">
          {
            skills.map((s, i) => (
              <li class="skill" data-reveal style={`--d:${(i % 4) * 0.06}s`}>
                <h3>{s.group}</h3>
                <ul class="chips">
                  {s.items.map((it) => (
                    <li class="chip">{it}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
        <div class="edu" data-reveal>
          <div>
            <h2>Education</h2>
            <p>
              {education.qualification}
              <span>{education.school}</span>
            </p>
          </div>
          <p class="yrs"><time datetime={education.years.slice(0, 4)}>{education.years}</time></p>
        </div>
      </div>
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <h2 id="contact-title" data-reveal>
          <span class="label">Contact</span><span class="sr-only">: </span>
          <span class="big">{contact.line1} <em class="accent">{contact.line2}</em></span>
        </h2>
        <p class="lead" data-reveal style="--d:.1s">{contact.text}</p>
        {config.openToWork && <p class="lead" data-reveal>{availabilityLine}</p>}
        <a class="mail" href={`mailto:${identity.email}`} data-reveal style="--d:.16s">{identity.email}</a>
        <div class="row" data-reveal style="--d:.22s">
          <a class="pill" href={`mailto:${identity.email}`}><span>Email me</span><span class="arrow"><Icon name="arrow" size={16} stroke={2.2} /></span></a>
          <a class="pill ghost" href={identity.linkedin} rel="me noopener">LinkedIn</a>
          <a class="pill ghost" href={identity.github} rel="me noopener">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© {year} {identity.name}. {identity.location}.</span>
      <span>This site works offline. Turn off your Wi-Fi and reload it.</span>
    </div>
  </footer>

  <script>
    import "../scripts/site.ts";
  </script>
</Base>
