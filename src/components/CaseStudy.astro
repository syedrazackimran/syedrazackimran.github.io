---
import type { CaseStudy } from "../data/profile";
import apps from "../data/apps.json";

interface Props {
  study: CaseStudy;
  variant: "raised" | "flat";
}

const { study, variant } = Astro.props;
const store = (apps as Record<string, { rating: number | null; ratingCount: number; fetchedAt: string }>)[study.key];
const asOf = store ? new Date(store.fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";
const showRating = study.key === "toastNow" && store?.rating != null;
const approxCount = store ? `~${Math.round(store.ratingCount / 1000)}K` : "";
---

<article class:list={["study", "reveal", "lift", variant]} aria-labelledby={`study-${study.key}`}>
  <header class="side">
    <h3 id={`study-${study.key}`}>{study.name}</h3>
    <p class="meta">{study.company}</p>
    <p class="role">{study.role}</p>
    {
      showRating && (
        <p class="rating meta">
          {study.name} is rated {store!.rating!.toFixed(1)} from {approxCount} ratings (App Store, as of {asOf}).
        </p>
      )
    }
    <p><a href={study.url}>{study.name} on the App Store</a></p>
  </header>
  <dl class="body">
    <div>
      <dt>The problem</dt>
      <dd><p>{study.problem}</p></dd>
    </div>
    <div>
      <dt>What I built</dt>
      <dd><ul>{study.built.map((b) => <li>{b}</li>)}</ul></dd>
    </div>
    <div>
      <dt>How</dt>
      <dd><p>{study.how}</p></dd>
    </div>
    <div>
      <dt>Result</dt>
      <dd><ul>{study.result.map((r) => <li>{r}</li>)}</ul></dd>
    </div>
  </dl>
</article>

<style>
  .study {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
    padding: var(--s-6);
    border-radius: var(--r-panel);
  }

  .raised {
    background: var(--paper);
  }

  .flat {
    border: 1px solid var(--rule);
  }

  .side {
    grid-column: span 4;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }

  .side h3 {
    font-size: 1.75rem;
    letter-spacing: -0.015em;
  }

  .side .meta:first-of-type {
    margin-top: calc(var(--s-3) * -1);
  }

  .rating {
    padding-left: var(--s-3);
    border-left: 2px solid var(--sync);
  }

  .body {
    grid-column: span 8;
    display: grid;
    gap: var(--s-5);
    margin: 0;
  }

  .body > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .body > div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  dt {
    font-weight: 600;
  }

  dd {
    margin: 0;
  }

  dd ul {
    display: grid;
    gap: var(--s-2);
    padding-left: 1.1em;
  }

  @media (max-width: 859px) {
    .side,
    .body {
      grid-column: 1 / -1;
    }
    .study {
      padding: var(--s-5);
    }
  }

  @media (max-width: 559px) {
    .body > div {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
