---
import { principles } from "../data/profile";
---

<section id="how-i-build" class="section wrap" aria-labelledby="how-title">
  <div class="section-head reveal">
    <h2 id="how-title">How I build</h2>
    <p>The habits behind reliable releases, as I'd explain them to a new teammate.</p>
  </div>

  <ol class="principles">
    {
      principles.map((p) => (
        <li class="reveal">
          <h3>{p.name}</h3>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .principles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-7);
    margin: 0;
    padding: 0;
  }

  li {
    position: relative;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  li::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 32px;
    height: 2px;
    background: var(--sync);
    transform-origin: left;
    transition: width var(--spring-duration) var(--spring);
  }

  li:hover::before {
    width: 96px;
  }

  h3 {
    font-family: var(--font-body);
    font-size: var(--step-body);
    font-weight: 700;
    letter-spacing: 0;
  }

  p {
    margin-top: var(--s-1);
    max-width: 52ch;
  }

  @media (max-width: 719px) {
    .principles {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
