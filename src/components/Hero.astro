---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import CopyEmail from "./CopyEmail.astro";
import apps from "../data/apps.json";
import { config, glance, hero, identity } from "../data/profile";

const store = (apps as Record<string, { rating: number | null; ratingCount: number; fetchedAt: string }>).toastNow;
const rating = store?.rating ?? 4.9;
const ratingCount = store ? `~${Math.round(store.ratingCount / 1000)}K` : "~12K";
const asOf = store
  ? new Date(store.fetchedAt).toLocaleDateString("en-GB", { month: "short", year: "numeric" })
  : "Oct 2026";

const words = hero.headline.split(" ");
---

<section class="hero wrap grid" aria-labelledby="hero-title">
  <div class="intro">
    <p class="kicker rise" style="--d: 0ms">
      <span class="pulse" aria-hidden="true"></span>
      {identity.current.role}, {identity.current.company}
    </p>
    <h1 id="hero-title">
      {
        words.map((word, i) => (
          <>
            <span class="word" style={`--d: ${80 + i * 45}ms`}>
              <span>{word}</span>
            </span>{" "}
          </>
        ))
      }
    </h1>
    <p class="supporting rise" style="--d: 620ms">{hero.supporting}</p>
    <p class="recognition meta rise" style="--d: 700ms">{hero.recognition}</p>
    <div class="actions rise" style="--d: 780ms">
      <span class="email">
        <a class="button" href={`mailto:${identity.email}`}>Email me</a>
        <CopyEmail />
      </span>
      <ul class="inline-links">
        {config.showResume && <li><a href="/resume.pdf">Download résumé</a></li>}
        <li><a href={identity.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={identity.github} rel="me">GitHub</a></li>
      </ul>
    </div>
  </div>

  <aside class="card rise" style="--d: 260ms" aria-label="At a glance">
    <div class="profile">
      {
        config.showPortrait && (
          <Picture
            src={portrait}
            alt={identity.name}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            widths={[160, 320, 390]}
            sizes="96px"
            quality={70}
            loading="eager"
            fetchpriority="high"
            class="portrait"
          />
        )
      }
      <div>
        <p class="name">{identity.name}</p>
        <p class="meta">{identity.title}</p>
        <p class="meta">{identity.location}</p>
      </div>
    </div>

    <dl class="stats">
      <div>
        <dt>{glance.years.label}</dt>
        <dd class="figure"><span data-count-to={glance.years.value}>{glance.years.value}</span>{glance.years.suffix}</dd>
      </div>
      <div>
        <dt>{glance.crashFree.label}</dt>
        <dd class="figure">{glance.crashFree.low}–<span data-count-to={glance.crashFree.high}>{glance.crashFree.high}</span>%</dd>
        <dd class="bar" aria-hidden="true"><span style={`--w: ${glance.crashFree.high}%`}></span></dd>
      </div>
      <div>
        <dt>{glance.countries.label}</dt>
        <dd class="figure"><span data-count-to={glance.countries.value}>{glance.countries.value}</span></dd>
      </div>
      <div>
        <dt>{glance.rating.label}, from {ratingCount} ratings (as of {asOf})</dt>
        <dd class="figure"><span data-count-to={rating} data-decimals="1">{rating.toFixed(1)}</span></dd>
      </div>
    </dl>
  </aside>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced) {
    const els = [...document.querySelectorAll<HTMLElement>("[data-count-to]")];
    const run = () => {
      const start = performance.now();
      const duration = 1400;
      const frame = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 4);
        for (const el of els) {
          const to = Number(el.dataset.countTo);
          const decimals = Number(el.dataset.decimals ?? 0);
          el.textContent = (to * eased).toFixed(decimals);
        }
        if (t < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    window.setTimeout(run, 450);
  }
</script>

<style>
  .hero {
    padding-block: var(--s-8);
    row-gap: var(--s-7);
    align-items: center;
    min-height: min(820px, calc(100svh - 64px));
  }

  .intro {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--s-5);
  }

  .card {
    grid-column: 8 / span 5;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--step-small);
    color: var(--graphite);
  }

  .pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sync);
    flex: none;
  }

  .pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--sync);
    animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) 1.2s infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }

  h1 {
    font-size: var(--step-hero);
    font-weight: 700;
    font-stretch: 86%;
    line-height: 1.02;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }

  .word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em;
    vertical-align: top;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .word > span {
    display: inline-block;
    animation: word-in 900ms var(--spring) var(--d) both;
  }

  @keyframes word-in {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  .rise {
    animation: rise 800ms cubic-bezier(0.16, 1, 0.3, 1) var(--d) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .supporting {
    font-size: 1.1875rem;
    max-width: 46ch;
  }

  .recognition {
    max-width: 62ch;
    margin-top: calc(var(--s-3) * -1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-2);
  }

  .email {
    display: inline-flex;
    gap: var(--s-2);
    margin-right: var(--s-7);
  }

  .card {
    position: relative;
    display: grid;
    gap: var(--s-5);
    padding: var(--s-6);
    background: var(--paper);
    border-radius: var(--r-card);
    box-shadow:
      0 1px 2px rgb(var(--shadow-tint) / 0.08),
      0 24px 56px -20px rgb(var(--shadow-tint) / 0.28);
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0 var(--s-6) auto;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--sync);
    transform-origin: left;
    animation: draw 1100ms cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule);
  }

  .profile :global(.portrait) {
    width: 96px;
    height: 96px;
    flex: none;
    border-radius: 22px;
    object-fit: cover;
    background: var(--steel);
    box-shadow: 0 0 0 1px var(--rule);
  }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--s-1);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5) var(--s-5);
    margin: 0;
  }

  .stats > div {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .figure {
    order: 1;
  }

  .bar {
    order: 2;
  }

  .stats dt {
    order: 3;
  }

  dt {
    font-size: var(--step-small);
    color: var(--graphite);
    line-height: 1.45;
  }

  dd {
    margin: 0;
  }

  .figure {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(2.25rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .bar {
    height: 4px;
    border-radius: var(--r-chip);
    background: var(--steel);
    overflow: hidden;
    margin-block: var(--s-1);
  }

  .bar span {
    display: block;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: var(--sync);
    transform-origin: left;
    animation: draw 1400ms cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
  }

  @media (max-width: 959px) {
    .intro,
    .card {
      grid-column: 1 / -1;
    }
    .card {
      max-width: 520px;
    }
    .hero {
      min-height: 0;
      padding-block: var(--s-7);
    }
  }

  @media (max-width: 419px) {
    .card {
      padding: var(--s-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .word > span,
    .rise,
    .card::before,
    .bar span,
    .pulse::after {
      animation: none;
    }
  }
</style>
