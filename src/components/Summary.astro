---
import { strengths, summary } from "../data/profile";
---

<section id="summary" class="section wrap grid" aria-labelledby="summary-title">
  <div class="lead reveal">
    <h2 id="summary-title">Summary</h2>
    <p class="text">{summary}</p>
  </div>
  <div class="strengths reveal">
    <h3>Key strengths</h3>
    <ul>{strengths.map((s) => <li>{s}</li>)}</ul>
  </div>
</section>

<style>
  section {
    row-gap: var(--s-6);
  }
  .lead {
    grid-column: 1 / span 6;
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .text {
    font-size: 1.1875rem;
    line-height: 1.6;
  }
  .strengths {
    grid-column: 8 / span 5;
  }
  h3 {
    font-family: var(--font-body);
    font-size: var(--step-body);
    font-weight: 700;
    margin-bottom: var(--s-3);
  }
  ul {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }
  li {
    position: relative;
    padding-left: var(--s-5);
  }
  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 2px solid var(--sync);
  }
  @media (max-width: 859px) {
    .lead,
    .strengths {
      grid-column: 1 / -1;
    }
  }
</style>
