---
const links = [
  { href: "#work", label: "Work" },
  { href: "#how-i-build", label: "How I build" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<a class="skip" href="#main">Skip to content</a>
<header class="header">
  <div class="wrap bar">
    <a class="wordmark" href="/">Imran</a>
    <nav aria-label="Sections">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme" type="button" data-theme-toggle aria-label="Colour theme: system">
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
      </svg>
      <span data-theme-label>System</span>
    </button>
  </div>
</header>

<script>
  const order = ["system", "light", "dark"] as const;
  type Mode = (typeof order)[number];
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = document.querySelector<HTMLElement>("[data-theme-label]");
  const names: Record<Mode, string> = { system: "System", light: "Light", dark: "Dark" };

  const read = (): Mode => {
    try {
      const v = localStorage.getItem("theme");
      return v === "light" || v === "dark" ? v : "system";
    } catch {
      return "system";
    }
  };

  const apply = (mode: Mode) => {
    const root = document.documentElement;
    if (mode === "system") delete root.dataset.theme;
    else root.dataset.theme = mode;
    try {
      if (mode === "system") localStorage.removeItem("theme");
      else localStorage.setItem("theme", mode);
    } catch {}
    if (label) label.textContent = names[mode];
    button?.setAttribute("aria-label", `Colour theme: ${names[mode].toLowerCase()}`);
  };

  let mode = read();
  apply(mode);
  button?.addEventListener("click", () => {
    mode = order[(order.indexOf(mode) + 1) % order.length] ?? "system";
    apply(mode);
  });
</script>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -100px;
    z-index: 20;
    padding: var(--s-3) var(--s-4);
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--r-button);
  }
  .skip:focus {
    top: var(--s-3);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--steel);
    border-bottom: 1px solid transparent;
  }

  @supports (animation-timeline: scroll()) {
    .header {
      animation: hairline linear both;
      animation-timeline: scroll();
      animation-range: 0 24px;
    }
    @keyframes hairline {
      to {
        border-bottom-color: var(--rule);
      }
    }
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
    min-height: 64px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    gap: var(--s-1) var(--s-5);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--sync);
  }

  .theme {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 36px;
    padding: 0 var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-chip);
    background: transparent;
    font-size: var(--step-small);
    cursor: pointer;
    transition: background-color var(--quick) ease;
  }
  .theme:hover {
    background: var(--paper);
  }

  @media (max-width: 719px) {
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      gap: var(--s-4);
      font-size: var(--step-small);
    }
    .bar {
      padding-top: var(--s-2);
    }
  }
</style>
