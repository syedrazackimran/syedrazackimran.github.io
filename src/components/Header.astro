---
const links = [
  { href: "#work", label: "Work" },
  { href: "#how-i-build", label: "How I build" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<a class="skip" href="#main">Skip to content</a>
<header class="header">
  <div class="wrap bar">
    <a class="wordmark" href="/">Imran</a>
    <nav aria-label="Sections">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M16.5 12.1A7 7 0 0 1 7.9 3.5a7 7 0 1 0 8.6 8.6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
      </svg>
      <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M10 1.75v2M10 16.25v2M1.75 10h2M16.25 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Two states only: the switch always flips what is on screen. Until someone taps it,
  // the page follows the device setting (and keeps following it if that changes).
  type Theme = "light" | "dark";
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
  const barColour: Record<Theme, string> = { light: "#e9edf0", dark: "#10171d" };

  const stored = (): Theme | null => {
    try {
      const v = localStorage.getItem("theme");
      return v === "light" || v === "dark" ? v : null;
    } catch {
      return null;
    }
  };
  const current = (): Theme => stored() ?? (systemDark.matches ? "dark" : "light");

  const render = () => {
    const theme = current();
    root.dataset.shown = theme;
    button?.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) meta.content = barColour[theme];
  };

  const choose = (theme: Theme) => {
    root.dataset.theme = theme;
    try {
      localStorage.setItem("theme", theme);
    } catch {}
    render();
  };

  button?.addEventListener("click", () => {
    const next: Theme = current() === "dark" ? "light" : "dark";
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reduced.matches) doc.startViewTransition(() => choose(next));
    else choose(next);
  });
  systemDark.addEventListener("change", render);
  render();
</script>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -100px;
    z-index: 20;
    padding: var(--s-3) var(--s-4);
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--r-button);
  }
  .skip:focus {
    top: var(--s-3);
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--steel);
    border-bottom: 1px solid transparent;
  }

  @supports (animation-timeline: scroll()) {
    .header {
      animation: hairline linear both;
      animation-timeline: scroll();
      animation-range: 0 24px;
    }
    @keyframes hairline {
      to {
        border-bottom-color: var(--rule);
      }
    }
  }

  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
    min-height: 64px;
  }

  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  nav ul {
    display: flex;
    gap: var(--s-1) var(--s-5);
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--sync);
  }

  .theme {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: var(--r-chip);
    background: transparent;
    cursor: pointer;
    transition: background-color var(--quick) ease;
  }
  .theme:hover {
    background: var(--paper);
  }
  .theme svg {
    grid-area: 1 / 1;
    transition:
      transform var(--spring-duration) var(--spring),
      opacity var(--quick) ease;
  }
  .sun,
  :global(html[data-shown="dark"]) .moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }
  :global(html[data-shown="dark"]) .sun {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 719px) {
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav ul {
      gap: var(--s-4);
      font-size: var(--step-small);
    }
    .bar {
      padding-top: var(--s-2);
    }
  }
</style>
