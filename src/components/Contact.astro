---
import CopyEmail from "./CopyEmail.astro";
import { availabilityLine, config, identity } from "../data/profile";
---

<section id="contact" class="section wrap" aria-labelledby="contact-title">
  <h2 id="contact-title" class="reveal">Contact</h2>
  <p class="lead reveal">Email is the quickest way to reach me.</p>
  {config.openToWork && <p>{availabilityLine}</p>}
  <div class="row">
    <a class="button big" href={`mailto:${identity.email}`}>Email me</a>
    <CopyEmail />
  </div>
  <p class="address meta">{identity.email}</p>
  <ul class="inline-links">
    <li><a href={identity.linkedin} rel="me">LinkedIn</a></li>
    <li><a href={identity.github} rel="me">GitHub</a></li>
    {config.showResume && <li><a href="/resume.pdf">Download résumé</a></li>}
  </ul>
</section>

<style>
  section {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .lead {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 600;
    font-stretch: 90%;
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }
  .row {
    display: flex;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }
  .big {
    min-height: 56px;
    padding-inline: var(--s-6);
    font-size: 1.1875rem;
  }
  .address {
    margin-top: calc(var(--s-3) * -1);
  }
</style>
