---
import CaseStudy from "./CaseStudy.astro";
import OwnApps from "./OwnApps.astro";
import { caseStudies, hackathons } from "../data/profile";
---

<section id="work" class="section wrap" aria-labelledby="work-title">
  <div class="section-head reveal">
    <h2 id="work-title">Work</h2>
    <p>Production apps for restaurant operators at Toast, and the apps I build on my own.</p>
  </div>

  <div class="studies">
    {caseStudies.map((study, i) => <CaseStudy study={study} variant={i === 0 ? "raised" : "flat"} />)}
  </div>

  <div class="hackathons reveal">
    <h3 class="group">Hackathon work</h3>
    <ul>
      {
        hackathons.map((h) => (
          <li>
            <span class="year meta">{h.year}</span>
            <div class="entry">
              <p>
                <strong>{h.result}</strong>
                {h.project && <span>, {h.project}</span>}
              </p>
              {h.problem && <p>{h.problem}</p>}
              {h.idea && <p>{h.idea}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <OwnApps />
</section>

<style>
  .studies {
    display: grid;
    gap: var(--s-5);
  }

  .hackathons {
    margin-block: var(--s-8);
  }

  .hackathons ul {
    list-style: none;
    margin-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .hackathons li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }

  .year {
    padding-top: 0.15em;
  }

  .entry {
    display: grid;
    gap: var(--s-1);
  }

  :global(.group) {
    font-size: var(--step-h3);
  }
</style>
