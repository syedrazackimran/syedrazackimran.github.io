---
import displayFont from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wdth-normal.woff2?url";
import bodyFont from "@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url";
import "../styles/tokens.css";
import "../styles/global.css";
import { education, experience, identity, keywords, metaDescription, skills, summary } from "../data/profile";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = metaDescription, noindex = false } = Astro.props;
const site = Astro.site ?? new URL("https://syedrazackimran.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;
const latin =
  "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";

const fontFaces = `
@font-face{font-family:"Bricolage Grotesque";src:url(${displayFont}) format("woff2");font-weight:200 800;font-stretch:75% 100%;font-display:swap;unicode-range:${latin}}
@font-face{font-family:"Atkinson Hyperlegible Next";src:url(${bodyFont}) format("woff2");font-weight:200 800;font-display:swap;unicode-range:${latin}}`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: identity.name,
  jobTitle: "Senior iOS Developer",
  worksFor: { "@type": "Organization", name: identity.current.company },
  address: { "@type": "PostalAddress", addressLocality: "Chennai", addressCountry: "IN" },
  email: `mailto:${identity.email}`,
  url: site.href,
  sameAs: [identity.linkedin, identity.github],
  description: summary,
  knowsAbout: skills.flatMap((g) => g.items.map((i) => i.replace(/\s*\(.*\)$/, ""))),
  alumniOf: { "@type": "EducationalOrganization", name: education.school },
  hasCredential: { "@type": "EducationalOccupationalCredential", credentialCategory: "Diploma", name: education.qualification },
  hasOccupation: experience.map((r) => ({
    "@type": "Occupation",
    name: r.role,
    occupationLocation: { "@type": "City", name: r.place },
    description: `${r.company}, ${r.years}. ${r.summary}`,
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch (e) {}
        var d = document.documentElement;
        d.dataset.shown = d.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#e9edf0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10171d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${identity.name}, Senior iOS Developer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
    <script>
      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
